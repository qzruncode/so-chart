{
  "name": "@so-chart/tabs",
  "version": "2.1.0",
  "description": "底层标签栏渲染能力",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qzruncode/so-chart.git",
    "directory": "packages/tabs"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "main": "./dist/tabs.umd.cjs",
  "module": "./dist/tabs.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/tabs.js",
      "require": "./dist/tabs.umd.cjs"
    }
  },
  "scripts": {
    "dev": "vite -c vite.dev.ts",
    "build": "vite build -c vite.prod.ts && tsc",
    "build:dev": "pnpm -F @so-chart/utils -F @so-chart/types build && pnpm build"
  },
  "keywords": [
    "tabs"
  ],
  "author": "ye",
  "license": "ISC",
  "dependencies": {
    "@so-chart/types": "workspace:^",
    "@so-chart/utils": "workspace:^",
    "d3": "^7.9.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^10.8.1",
    "less": "^4.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.1"
  },
  "peerDependencies": {
    "d3": "^7.9.0"
  }
}
