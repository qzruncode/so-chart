{
  "name": "@so-chart/table3d",
  "version": "0.2.0",
  "description": "基于 Three.js 的仿真 PBR 3D 桌子图表",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qzruncode/so-chart.git",
    "directory": "packages/table3d"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "main": "./dist/table3d.umd.cjs",
  "module": "./dist/table3d.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/table3d.js",
      "require": "./dist/table3d.umd.cjs"
    }
  },
  "scripts": {
    "dev": "vite -c vite.dev.ts",
    "build": "vite build -c vite.prod.ts && tsc",
    "build:dev": "pnpm -F @so-chart/utils -F @so-chart/types build && pnpm build"
  },
  "keywords": [
    "table",
    "3d",
    "webgl",
    "three",
    "pbr"
  ],
  "author": "ye",
  "license": "ISC",
  "dependencies": {
    "@so-chart/types": "workspace:^",
    "@so-chart/utils": "workspace:^"
  },
  "peerDependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "eslint": "^10.8.1",
    "three": "^0.186.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.1"
  }
}
