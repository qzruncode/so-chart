{
  "name": "@so-chart/basket",
  "version": "1.0.0",
  "description": "基于 Three.js 的真实藤编 PBR 3D 空篮图表",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qzruncode/so-chart.git",
    "directory": "packages/basket"
  },
  "type": "module",
  "files": [
    "dist",
    "ASSETS.md"
  ],
  "types": "./dist/index.d.ts",
  "main": "./dist/basket.umd.cjs",
  "module": "./dist/basket.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/basket.js",
      "require": "./dist/basket.umd.cjs"
    }
  },
  "scripts": {
    "dev": "vite -c vite.dev.ts",
    "build": "vite build -c vite.prod.ts && tsc",
    "build:dev": "pnpm -F @so-chart/types -F @so-chart/utils build && pnpm build"
  },
  "keywords": [
    "wicker-basket",
    "empty-basket",
    "3d",
    "webgl",
    "three",
    "pbr"
  ],
  "author": "ye",
  "license": "ISC",
  "dependencies": {
    "@so-chart/types": "workspace:^",
    "@so-chart/utils": "workspace:^"
  },
  "peerDependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "eslint": "^10.8.1",
    "three": "^0.186.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.1"
  }
}
