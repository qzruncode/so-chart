{
  "private": true,
  "name": "so-chart",
  "version": "1.0.0",
  "description": "Composable chart components built with D3, Canvas, and SVG.",
  "type": "module",
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": ">=22.22.2 <26",
    "pnpm": ">=9 <10"
  },
  "scripts": {
    "dev": "vite -c vite.dev.ts",
    "build": "pnpm -r run build",
    "preview": "vite -c vite.preview.ts",
    "preview:build": "pnpm run build && vite build -c vite.prod.ts",
    "bench": "vitest bench --run",
    "bench:ui": "vitest bench --ui",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish --tag latest --no-git-tag",
    "release:check": "node scripts/check-release.mjs",
    "release": "pnpm release:check && pnpm changeset:publish",
    "test": "vitest run",
    "lint": "eslint .",
    "fix": "eslint . --fix",
    "prepare": "husky"
  },
  "keywords": [
    "d3",
    "chart",
    "react",
    "svg",
    "canvas"
  ],
  "author": "ye",
  "license": "ISC",
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@so-chart/bar": "workspace:*",
    "@so-chart/calendar": "workspace:*",
    "@so-chart/guage": "workspace:*",
    "@so-chart/line": "workspace:*",
    "@so-chart/pie": "workspace:*",
    "@so-chart/point": "workspace:*",
    "@so-chart/progress": "workspace:*",
    "@so-chart/radar": "workspace:*",
    "@so-chart/sankey": "workspace:*",
    "@so-chart/tabs": "workspace:*",
    "@so-chart/tree": "workspace:*",
    "@so-chart/types": "workspace:*",
    "@types/react-syntax-highlighter": "^15.5.13",
    "antd": "^6.5.4",
    "highlight.js": "^11.11.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-highlight": "^7.0.2"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8"
  ],
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix",
    "*": [
      "prettier --ignore-unknown --write",
      "git add"
    ]
  },
  "workspaces": [
    "packages/line",
    "packages/utils",
    "packages/tabs",
    "packages/tooltip",
    "packages/bar",
    "packages/types",
    "packages/pie",
    "packages/guage",
    "packages/radar",
    "packages/point",
    "packages/tree",
    "packages/calendar",
    "packages/sankey",
    "packages/progress"
  ]
}
